# OpenAI API (server-side only — never expose this to the browser)
OPENAI_API_KEY=

# Optional: which OpenAI models write the copy. Leave blank for the
# defaults (gpt-6-sol for copy, gpt-6-luna for the quick jobs like the
# quality check). If a model ever errors, every call retries on the
# fallback (gpt-4o / gpt-4o-mini) automatically. See lib/ai/client.ts.
OPENAI_COPY_MODEL=
OPENAI_UTILITY_MODEL=

# Firebase (client config is safe to expose; these are the public web keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — used by app/api/stripe/webhook and the
# other Stripe routes to write Firestore with no signed-in user on the
# request). Get this from:
#   Firebase console → your project → gear icon → Project settings
#   → Service accounts tab → "Generate new private key"
# That downloads a .json file. Paste its ENTIRE contents here as ONE LINE
# (no line breaks) — most editors have a "join lines" command for this.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Stripe — use TEST MODE values while building (toggle "Test mode" in the
# top-right of the Stripe Dashboard before doing any of this; test keys
# start with sk_test_/pk_test_/whsec_test-looking strings, so you can tell
# at a glance you're not touching real money).
#
# 1. STRIPE_SECRET_KEY — Dashboard → Developers → API keys → "Secret key"
#    (with Test mode toggled on). Starts with sk_test_...
#
# 2. STRIPE_PRICE_STARTER / STRIPE_PRICE_PRO — Dashboard → Product catalog
#    → "+ Add product". Create two products, each with one recurring
#    monthly price:
#      Starter — $39.00/month
#      Pro     — $99.00/month
#    No free trial on either price. After saving each product, open it and
#    copy its Price id (starts with price_...) into the matching line below.
#
# 2b. STRIPE_PRICE_STARTER_YEARLY / STRIPE_PRICE_PRO_YEARLY — same two
#    products, but add a SECOND price to each (a Stripe price is locked to
#    one billing interval, so yearly needs its own price, not a toggle on
#    the monthly one): "+ Add another price" → Yearly, matching the sales
#    page's "2 months free" framing:
#      Starter — $396.00/year ($33/mo equivalent)
#      Pro     — $996.00/year ($83/mo equivalent)
#    Copy each new price's id into the matching line below. Until these
#    are set, the Yearly option is simply unavailable — checkout returns a
#    clear error instead of charging the wrong amount.
#
# 3. STRIPE_WEBHOOK_SECRET — Dashboard → Developers → Webhooks → "+ Add
#    endpoint". Endpoint URL: https://<your-deployed-domain>/api/stripe/webhook
#    (for local testing, use the Stripe CLI instead: `stripe listen
#    --forward-to localhost:3000/api/stripe/webhook`, which prints a
#    whsec_... value directly in the terminal — use that one locally).
#    Events to send: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted. After creating it, click "Reveal" next
#    to "Signing secret" and copy the whsec_... value below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_WEBHOOK_SECRET=

# MailerLite — tags people "Customer" (and removes "Signed Up - Unpaid")
# the moment they pay, via the Stripe webhook above (see lib/mailerlite.ts).
# Get the API key from MailerLite → Integrations → API. Get each group id
# by opening that group in MailerLite and copying the id from the URL.
MAILERLITE_API_KEY=
ML_GROUP_UNPAID=
ML_GROUP_CUSTOMER=

# Sentry (error tracking) — the DSN is safe to expose to the browser,
# same as the Firebase keys above; it's a write-only endpoint for
# sending error reports, not a secret. Get it from sentry.io → your
# project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Email sign-in codes ("Email me a code" on the sign-in page). Sent with
# Resend (resend.com): create an account, add and verify your sending domain
# (campeos.com) under Domains, then make an API key under API Keys.
# AUTH_EMAIL_FROM must use that verified domain, for example:
#   Campeos <login@campeos.com>
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Meta ads tracking (see lib/meta/*). The Pixel ID is public. The access
# token is secret: Events Manager -> your Pixel -> Settings -> Conversions
# API -> Generate access token. Server only, never NEXT_PUBLIC_.
# META_TEST_EVENT_CODE is only for testing (Events Manager -> Test events):
# set it while testing, remove it before launch.
NEXT_PUBLIC_META_PIXEL_ID=1120448007443391
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
