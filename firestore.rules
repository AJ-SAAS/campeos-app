rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A campaign belongs to exactly one user (the "uid" field on the
    // document). Only that user can read, create, update, or delete it
    // or its steps. There's no sharing/collaboration in v1.
    match /campaigns/{campaignId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;

      match /steps/{stepId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.uid;
      }
    }

    // Per-user library: pasted winning copy and sales-call themes. See
    // lib/firebase/library.ts.
    match /winners/{winnerId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /salesCalls/{callId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Buyer insights: calls, testimonials, stories and more, one document
    // each, owned by the user. See lib/firebase/insights.ts.
    match /insights/{insightId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Per-user saved offers — what a client sells, reusable across
    // campaigns. See lib/firebase/offers.ts.
    match /offers/{offerId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Finished Daily Reset sprints, one doc each, owned by the user. See
    // lib/firebase/dailySprints.ts.
    match /dailySprints/{sprintId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // The agent's chat history, scoped to the user. See
    // lib/firebase/agentThreads.ts.
    match /agentMessages/{messageId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Daily AI-generation usage counter, one doc per user, keyed by the
    // user's own uid as the document id. See lib/firebase/usage.ts.
    match /usage/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // What the agent remembers about this user's business between
    // conversations, one doc per user, keyed by uid. See
    // lib/firebase/businessProfile.ts.
    match /businessProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Subscription/plan status, one doc per user, keyed by uid. READ ONLY
    // from the client — a user can see their own plan, but only the
    // Stripe webhook (via the Admin SDK, which bypasses these rules
    // entirely) can ever set it. If this allowed client writes, anyone
    // could grant themselves "active" from the browser console. See
    // lib/firebase/subscription.ts and app/api/stripe/webhook/route.ts.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
